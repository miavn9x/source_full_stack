NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/business
CORS_ORIGIN=http://localhost:3000

JWT_ACCESS_SECRET=change-me-to-a-random-32-character-secret
JWT_REFRESH_SECRET=change-me-to-another-random-32-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Self-hosted Plasmic
PLASMIC_HOST=https://studio.example.com
PLASMIC_API_HOST=http://127.0.0.1:3003
PLASMIC_PROJECT_ID=
PLASMIC_PROJECT_API_TOKEN=
PLASMIC_WEBHOOK_SECRET=

# Next.js on-demand revalidation
NEXT_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# Media storage (optional for the first slice)
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Seed only
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
