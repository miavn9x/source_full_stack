# ==============================================================================
# Plasmic Studio WAB — Cấu hình môi trường (Native, không Docker)
# Copy file này thành .env tại: C:\plasmic\platform\wab\.env
# ==============================================================================

# --- Nguồn mã nguồn (clone từ GitHub) ---
PLASMIC_REPO_URL=https://github.com/plasmicapp/plasmic.git
PLASMIC_REPO_REF=main

# --- Server ---
NODE_ENV=development
PORT=3003
PUBLIC_URL=http://localhost:3003

# --- PostgreSQL (DB riêng cho Plasmic Studio) ---
# Cài PostgreSQL native trên Windows: https://www.postgresql.org/download/windows/
PLASMIC_DB_USER=plasmic
PLASMIC_DB_PASSWORD=112233
PLASMIC_DB_NAME=plasmic

DATABASE_URL=postgresql://plasmic:112233@127.0.0.1:5432/plasmic
DATABASE_URI=postgres://plasmic:112233@127.0.0.1:5432/plasmic
WAB_DBNAME=plasmic
WAB_DBPASSWORD=112233

# --- S3 / Storage (để trống khi dev local) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Secrets ---
JWT_SECRET=plasmic_dev_jwt_secret_local
SESSION_SECRET=plasmic_dev_session_secret_local

# --- Webhook sang NestJS Backend ---
PLASMIC_WEBHOOK_SECRET=plasmic_webhook_secret_dev
PLASMIC_WEBHOOK_URL=http://127.0.0.1:4000/api/v1/webhooks/plasmic

# ==============================================================================
# Sau khi tạo Project trong Studio, điền vào frontend/.env.local:
# NEXT_PUBLIC_PLASMIC_HOST=http://localhost:3003
# NEXT_PUBLIC_PLASMIC_API_HOST=http://localhost:3003
# NEXT_PUBLIC_PLASMIC_PROJECT_ID=<Project ID từ Studio>
# NEXT_PUBLIC_PLASMIC_TOKEN=<Read-only token từ Project Settings>
# ==============================================================================
